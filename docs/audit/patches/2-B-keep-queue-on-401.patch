diff --git a/public/js/telemetry.js b/public/js/telemetry.js
index db35ec8..00b97a6 100644
--- a/public/js/telemetry.js
+++ b/public/js/telemetry.js
@@ -79,6 +79,11 @@ export async function flush(keepalive = false) {
     }
     if (batch) {
       const status = await post('/events', { opId: batch.opId, events: batch.events }, keepalive).catch(() => 0);
+      // 沒有登入（401）不是資料的問題：留著、不算次數，重新登入之後再送
+      if (status === 401) {
+        write('telemetryBatch', batch);
+        return;
+      }
       batch.tries += 1;
       // 成功、或是資料本身有問題（4xx，重送也不會好）、或送太多次了：丟掉這一批
       if ((status >= 200 && status < 500) || batch.tries >= MAX_TRIES) write('telemetryBatch', null);
@@ -89,6 +94,10 @@ export async function flush(keepalive = false) {
     const keep = [];
     for (const item of logs) {
       const status = await post('/battle-log', { opId: item.opId, log: item.log }).catch(() => 0);
+      if (status === 401) {
+        keep.push(item);
+        continue;
+      }
       item.tries += 1;
       if (!(status >= 200 && status < 500) && item.tries < MAX_TRIES) keep.push(item);
     }
