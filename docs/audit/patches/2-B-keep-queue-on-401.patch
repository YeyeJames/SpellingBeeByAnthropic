@@ -88,6 +94,16 @@ export async function flush() {
       try {
         result = await api.post(op.path, { ...op.body, opId: op.opId });
       } catch (err) {
+        /*
+         * 401 不是「資料有問題」，是「現在沒有登入」——這筆資料本身完全沒錯。
+         * 本來跟其他 4xx 一起被丟掉：登入剛好在練習途中失效的話，之後答的每一題
+         * 都無聲無息地消失（docs/audit/step2 的 S4）。改成留著、停下來，
+         * 重新登入之後照原樣補送；opId 讓伺服器不會重複計分。
+         */
+        if (err.status === 401) {
+          authLost = true;
+          break;
+        }
         if (err.status && err.status >= 400 && err.status < 500) {
           // 用戶端錯誤（資料有問題、金幣不足）重試也不會成功，
           // 丟掉這筆避免卡住整個佇列，並通知畫面回復先前的樂觀更新
@@ -100,6 +116,7 @@ export async function flush() {
